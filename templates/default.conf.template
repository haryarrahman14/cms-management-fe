client_body_timeout        30s;
send_timeout               300s;
reset_timedout_connection  on;
keepalive_requests         10000;

error_log                  stderr ${ERROR_LOG_LEVEL};
resolver                   dns-default.openshift-dns.svc.cluster.local valid=10s;

server {
    listen                 5173 reuseport default_server backlog=100;
    server_name            _;

    # gzip
    gzip            on;
    gzip_vary       on;
    gzip_proxied    any;
    gzip_comp_level 6;
    gzip_types      text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    port_in_redirect       off;
    absolute_redirect      off;
    autoindex              off;

    root                   /usr/share/nginx/html;

    charset                utf-8;
    sendfile               on;
    sendfile_max_chunk     512k;
    tcp_nopush             on;
    tcp_nodelay            off;
    log_not_found          off;
    types_hash_max_size    2048;
    types_hash_bucket_size 64;
    client_max_body_size   16M;

    merge_slashes          on;

    ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
    proxy_set_header X-Forwarded-For $remote_addr;
    ssl_ciphers "EECDH+AESGCM:EDH+AESGCM:ECDHE-RSA-AES128-GCM-SHA256:AES256+EECDH:DHE-RSA-AES128-GCM-SHA256:AES256+EDH:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA:ECDHE-RSA-AES128-SHA:DHE-RSA-AES256-SHA256:DHE-RSA-AES128-SHA256:DHE-RSA-AES256-SHA:DHE-RSA-AES128-SHA:ECDHE-RSA-DES-CBC3-SHA:EDH-RSA-DES-CBC3-SHA:AES256-GCM-SHA384:AES128-GCM-SHA256:AES256-SHA256:AES128-SHA256:AES256-SHA:AES128-SHA:DES-CBC3-SHA:HIGH:!aNULL:!eNULL:!EXPORT:!DES:!MD5:!PSK:!RC4";
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    # security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload";
    add_header Content-Security-Policy "default-src 'self' *.syariahbtpn.com *.btpnsyariah.com *.apps.btpnsyariah.com 'unsafe-eval' 'unsafe-inline'; font-src *; img-src * data:; script-src *; style-src *; object-src 'none'";
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Access-Control-Allow-Origin ${CORS_ALLOW_HOST};

    header_filter_by_lua_block {
        ngx.header['server'] = "${APP_NAME}"
    }

    location = /logout {
        tcp_nodelay             on;

        proxy_http_version      1.1;
        proxy_set_header        "Connection" "";
        proxy_set_header         Host "${SSO_SSL_SNI_NAME}";

        proxy_buffering          off;
        proxy_ssl_name           "${SSO_SSL_SNI_NAME}";
        proxy_ssl_server_name    on;
        proxy_ssl_protocols      TLSv1.1 TLSv1.2 TLSv1.3;
        proxy_ssl_session_reuse  off;
        proxy_ssl_verify         off;

        proxy_connect_timeout    30s;
        proxy_read_timeout       2m;
        proxy_socket_keepalive   on;

        proxy_next_upstream      off;

        proxy_pass               "https://sso${SSO_UPSTREAM_PATH}/realms/${SSO_REALM_NAME}/protocol/openid-connect/logout";
    }

    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files ${DOLLAR}uri ${DOLLAR}uri/ /index.html;

        # kill cache
        add_header Last-Modified $date_gmt;
        add_header Cache-Control 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0';
        if_modified_since off;
        expires off;
        etag off;
    }

    error_page  404              /404.html;
    error_page  403              /403.html;

    # redirect server error pages to the static page /50x.html
    #
    error_page   500 502 503 504  /50x.html;

    location = /403.html {
        internal;
        root   /usr/share/nginx/html;
    }
    location = /404.html {
        internal;
        root   /usr/share/nginx/html;
    }
    location = /50x.html {
        internal;
        root   /usr/share/nginx/html;
    }

    location /api/ {
        access_by_lua_block {
            local jwt_csrf = require("btpns.worker-ctx").get("jwt_csrf")
            if not jwt_csrf then
                return
            end

            local filtered, _, session_id = jwt_csrf:verify_access()

            if not filtered then
                ngx.log(ngx.DEBUG, "access token is not valid")
                ngx.exit(ngx.HTTP_FORBIDDEN)
            end
        }

        tcp_nodelay             on;

        proxy_http_version      1.1;
        #proxy_set_header        "Connection" "";

        proxy_buffering          off;

        proxy_connect_timeout    90s;
        proxy_read_timeout       2m;
        proxy_socket_keepalive   on;

        proxy_next_upstream      error timeout;

        proxy_set_header         Host ${DOLLAR}host;
        proxy_redirect           off;

    }
}

upstream sso {
    keepalive 32;

    server ${SSO_HOSTNAME_PORT} max_fails=1 ${SSO_UPSTREAM_OPTS};
}